<?xml version="1.0" encoding="utf-8"?>
<!-- Lucifer Launcher landscape shell: angular cyan side rail, native navigation and full-screen content. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lucifer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="?attr/bgMainDrawable">

    <!-- ═══════════════════════════════════════════════════════════════════════
         ANGULAR SIDE RAIL — avatar, then the native launcher destinations
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/side_rail"
        android:background="@drawable/bg_lucifer_slanted_panel"
        android:elevation="6dp"
        android:layout_width="@dimen/_84sdp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_4sdp"
        android:paddingVertical="@dimen/_6sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/rail_avatar_shell"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginBottom="@dimen/_4sdp">

            <ImageView
                android:id="@+id/iv_rail_emblem"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:src="@drawable/lucifer_launcher_mark"
                android:scaleType="fitCenter"
                android:contentDescription="Lucifer Launcher" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/nav_home"
                style="@style/LiquidRailItem"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Home">
                <ImageView android:id="@+id/nav_home_icon" style="@style/LiquidRailIcon" android:src="@drawable/ic_home" />
                <TextView android:id="@+id/nav_home_label" style="@style/LiquidRailLabel" android:text="HOME" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_instances"
                style="@style/LiquidRailItem"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Profiles">
                <ImageView android:id="@+id/nav_instances_icon" style="@style/LiquidRailIcon" android:src="@drawable/ic_folder_managed" />
                <TextView android:id="@+id/nav_instances_label" style="@style/LiquidRailLabel" android:text="PROFILES" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_mod_store"
                style="@style/LiquidRailItem"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Mods">
                <ImageView android:id="@+id/nav_mod_store_icon" style="@style/LiquidRailIcon" android:src="@drawable/ic_download_box" />
                <TextView android:id="@+id/nav_mod_store_label" style="@style/LiquidRailLabel" android:text="MODS" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_servers"
                style="@style/LiquidRailItem"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Servers">
                <ImageView android:id="@+id/nav_servers_icon" style="@style/LiquidRailIcon" android:src="@drawable/ic_mc_block" />
                <TextView android:id="@+id/nav_servers_label" style="@style/LiquidRailLabel" android:text="SERVERS" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_custom_controls"
                style="@style/LiquidRailItem"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Controls">
                <ImageView android:id="@+id/nav_controls_icon" style="@style/LiquidRailIcon" android:src="@drawable/ic_menu_custom_controls" />
                <TextView android:id="@+id/nav_controls_label" style="@style/LiquidRailLabel" android:text="CONTROLS" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_skin"
                style="@style/LiquidRailItem"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Skins">
                <ImageView android:id="@+id/nav_skin_icon" style="@style/LiquidRailIcon" android:src="@drawable/ic_manage_skin" />
                <TextView android:id="@+id/nav_skin_label" style="@style/LiquidRailLabel" android:text="SKINS" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_wallpapers"
                style="@style/LiquidRailItem"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_wallpapers">
                <ImageView android:id="@+id/nav_wallpapers_icon" style="@style/LiquidRailIcon" android:src="@drawable/ic_wallpaper" />
                <TextView android:id="@+id/nav_wallpapers_label" style="@style/LiquidRailLabel" android:text="SCENE" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_dock_settings"
                style="@style/LiquidRailItem"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="Settings">
                <ImageView style="@style/LiquidRailIcon" android:src="@drawable/ic_menu_settings" android:tint="@color/lg_text_primary" />
                <TextView style="@style/LiquidRailLabel" android:text="SETTINGS" android:textColor="@color/lg_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER BAR — brand, scene/cursor/about chips and launcher status,
         account spinner and the settings gear
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:background="@drawable/bg_lucifer_header"
        android:elevation="8dp"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/side_rail"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/btn_home_logo"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Lucifer Launcher home">
            <ImageView
                android:id="@+id/iv_lucifer_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/lucifer_launcher_mark"
                android:scaleType="fitCenter"
                android:contentDescription="Lucifer Launcher logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_launcher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:text="LUCIFER"
            android:textColor="@color/lg_text_primary"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDx="0.6"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:clickable="true"
            android:focusable="true" />

        <Space
            android:layout_width="@dimen/_8sdp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/nav_cursor"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_26sdp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_7sdp"
            android:background="@drawable/bg_liquid_pill"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cursor Studio">
            <ImageView
                android:id="@+id/nav_cursor_icon"
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/ic_mouse_pointer"
                android:tint="@color/lg_text_primary"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/nav_cursor_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_3sdp"
                android:text="Cursor"
                android:textColor="@color/lg_text_primary"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_about"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_26sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_7sdp"
            android:background="@drawable/bg_liquid_pill"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="About Lucifer Launcher">
            <ImageView
                android:id="@+id/nav_about_icon"
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/ic_menu_news"
                android:tint="@color/lg_text_primary"
                android:contentDescription="@null" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_creator_team"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_26sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:minWidth="@dimen/_34sdp"
            android:paddingHorizontal="@dimen/_7sdp"
            android:text="✦ PRO"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold"
            android:textColor="@color/lg_ink"
            android:background="@drawable/bg_liquid_pill"
            app:backgroundTint="@null"
            android:contentDescription="Creator team credits" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- live telemetry: renderer · fps pack · ram (tap = graphics, long-press = fix ladder) -->
        <LinearLayout
            android:id="@+id/hud_telemetry_plate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_28sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_8sdp"
            android:background="@drawable/bg_liquid_pill"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_hud_renderer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MobileGlues"
                android:textColor="@color/lg_accent_bright"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_4sdp"
                android:text="·"
                android:textColor="@color/lg_secondary"
                android:textSize="@dimen/_9ssp" />

            <TextView
                android:id="@+id/tv_hud_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.21+ FPS PACK"
                android:textColor="@color/lg_text_secondary"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_4sdp"
                android:text="·"
                android:textColor="@color/lg_secondary"
                android:textSize="@dimen/_9ssp" />

            <TextView
                android:id="@+id/tv_hud_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6.0 GB RAM"
                android:textColor="@color/lg_text_primary"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="@dimen/_112sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:background="@drawable/bg_account_spinner"
            android:dropDownWidth="@dimen/_220sdp"
            android:dropDownVerticalOffset="@dimen/_34sdp"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_4sdp" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/bg_settings_btn"
            android:src="@drawable/ic_menu_settings"
            android:tint="@color/lg_text_primary"
            android:scaleType="fitCenter"
            android:padding="@dimen/_5sdp"
            android:contentDescription="Settings"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CONTENT STAGE — Home / Profiles / Mods / Servers / Skins
         ═══════════════════════════════════════════════════════════════════════ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintBottom_toTopOf="@+id/bottom_dock_bar"
        app:layout_constraintStart_toEndOf="@+id/side_rail"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintStart_toEndOf="@+id/side_rail"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         STATUS STRIP — selected server list state and launcher branding
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_dock_bar"
        android:background="@drawable/bg_lucifer_slanted_panel"
        android:elevation="4dp"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/side_rail"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/lg_online"
            android:textSize="@dimen/_8ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:text="SAVED SERVERS · STATUS NOT CHECKED"
            android:textColor="@color/lg_text_primary"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="NATIVE"
            android:textColor="@color/lg_accent_bright"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LUCIFER LAUNCHER"
            android:textColor="@color/lg_text_tertiary"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />
    </LinearLayout>


    <include
        android:id="@+id/lucifer_splash_overlay"
        layout="@layout/lucifer_splash_screen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
