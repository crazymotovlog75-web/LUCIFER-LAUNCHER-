<?xml version="1.0" encoding="utf-8"?>
<!--
    HOME — LIQUID CRYSTAL CLEAR (L03 content stage)
    Hero glass card on the left (instance, spec rows, skin, READY TO LAUNCH), server + instances
    glass cards on the right, and the TOP MODS / shortcuts strip along the bottom.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Optional custom user wallpaper layer (kept for the wallpaper studio) -->
    <ImageView
        android:id="@+id/right_pane_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.32"
        android:visibility="gone"
        android:contentDescription="@null" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_hero_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.62" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         HERO — the active instance
         ═══════════════════════════════════════════════════════════════════════ -->
    <net.kdt.pojavlaunch.ui.GlassFrameLayout
        android:id="@+id/home_instance_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/home_strip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guide_hero_end"
        app:lgRadius="26dp"
        app:lgTint="84"
        app:lgScrim="78"
        app:lgRefraction="0.06">

        <ImageView
            android:id="@+id/iv_home_avatar"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_30sdp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/player_skin_preview" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_9sdp">

            <TextView
                style="@style/LiquidLabel"
                android:text="FABRIC 1.21.4"
                android:textColor="@color/lg_accent_bright" />

            <TextView
                android:id="@+id/tv_home_profile_name"
                style="@style/LiquidTitle"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="Shadow PvP"
                android:textSize="@dimen/_17ssp"
                android:ellipsize="end" />

            <!-- spec rows: version / fabric / active -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/_16sdp">
                    <TextView style="@style/LiquidLabel" android:text="VERSION" android:textSize="@dimen/_6ssp" />
                    <TextView
                        android:id="@+id/tv_home_version"
                        style="@style/LiquidValue"
                        android:text="1.21.10"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/_16sdp">
                    <TextView style="@style/LiquidLabel" android:text="FABRIC" android:textSize="@dimen/_6ssp" />
                    <TextView
                        android:id="@+id/tv_home_loader"
                        style="@style/LiquidValue"
                        android:text="0.16.9"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/LiquidLabel" android:text="ACTIVE" android:textSize="@dimen/_6ssp" />
                    <TextView
                        android:id="@+id/tv_home_mod_count"
                        style="@style/LiquidValue"
                        android:text="—"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>
            </LinearLayout>

            <!-- spec rows: renderer / shaders / server -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:orientation="horizontal">
                    <TextView style="@style/LiquidLabel" android:layout_width="@dimen/_58sdp" android:text="RENDERER" android:textSize="@dimen/_6ssp" android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tv_home_renderer"
                        style="@style/LiquidValue"
                        android:text="—"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:orientation="horizontal">
                    <TextView style="@style/LiquidLabel" android:layout_width="@dimen/_58sdp" android:text="SHADERPACKS" android:textSize="@dimen/_6ssp" android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tv_home_shaderpacks"
                        style="@style/LiquidValue"
                        android:text="—"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView style="@style/LiquidLabel" android:layout_width="@dimen/_58sdp" android:text="SERVER" android:textSize="@dimen/_6ssp" android:gravity="center_vertical" />
                    <TextView style="@style/LiquidValue" android:text="LuciferMC · 24 ms" android:textSize="@dimen/_9ssp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- RAM + READY TO LAUNCH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_home_ram"
                    style="@style/LiquidValue"
                    android:text="6.0 GB"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    style="@style/LiquidLabel"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:text="RAM ALLOC"
                    android:textSize="@dimen/_6ssp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/btn_launch_portal"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp"
                    android:minWidth="@dimen/_150sdp"
                    android:background="@drawable/bg_liquid_accent_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Launch selected Minecraft instance">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_launch_glyph"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶"
                            android:textColor="@color/lg_ink"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:id="@+id/tv_launch_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:text="READY TO LAUNCH"
                            android:textColor="@color/lg_ink"
                            android:textSize="@dimen/_9ssp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:maxLines="1" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_launch_version_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="1.21.10"
                android:textColor="@color/lg_text_tertiary"
                android:textSize="@dimen/_6ssp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_home_skins"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:background="@drawable/bg_liquid_chip"
                android:text="✦ SKIN STUDIO"
                android:textColor="@color/lg_text_primary"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </net.kdt.pojavlaunch.ui.GlassFrameLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         RIGHT COLUMN — server, instances, arsenal shortcuts
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/home_right_col"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_5sdp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/home_strip"
        app:layout_constraintStart_toEndOf="@+id/guide_hero_end"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LUCIFERMC — official server -->
        <net.kdt.pojavlaunch.ui.GlassLinearLayout
            android:id="@+id/home_server_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_7sdp"
            android:clickable="true"
            android:focusable="true"
            app:lgRadius="22dp"
            app:lgTint="66"
            app:lgScrim="90"
            app:lgRefraction="0.05">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_home_server_pitch"
                    style="@style/LiquidValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="LUCIFERMC"
                    android:textSize="@dimen/_11ssp"
                    android:letterSpacing="0.06"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:background="@drawable/bg_liquid_pill"
                    android:text="OFFICIAL"
                    android:textColor="@color/lg_text_primary"
                    android:textSize="@dimen/_6ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                style="@style/LiquidLabel"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="LIFESTEEL SMP"
                android:textSize="@dimen/_6ssp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/LiquidLabel"
                    android:text="PLAYERS"
                    android:textSize="@dimen/_6ssp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/LiquidValue"
                    android:text="12 / 200"
                    android:textSize="@dimen/_8ssp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:background="@drawable/bg_liquid_pill"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_1sdp"
                android:text="play.lucifermc.fun   ● LIVE · 24ms"
                android:textColor="@color/lg_accent_bright"
                android:textSize="@dimen/_7ssp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_home_servers"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_liquid_accent_button"
                    android:gravity="center"
                    android:text="JOIN"
                    android:textColor="@color/lg_ink"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_home_discord"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_weight="0.9"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="@drawable/bg_liquid_chip"
                    android:gravity="center"
                    android:text="DISCORD"
                    android:textColor="@color/lg_text_primary"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_home_wiki"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_weight="0.9"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="@drawable/bg_liquid_chip"
                    android:gravity="center"
                    android:text="WIKI"
                    android:textColor="@color/lg_text_primary"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </net.kdt.pojavlaunch.ui.GlassLinearLayout>

        <!-- INSTANCES — quick switch shelf -->
        <net.kdt.pojavlaunch.ui.GlassLinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_7sdp"
            app:lgRadius="22dp"
            app:lgTint="66"
            app:lgScrim="90"
            app:lgRefraction="0.05">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/LiquidLabel" android:text="INSTANCES" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_home_instances"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:background="@drawable/bg_liquid_pill"
                    android:text="ALL ›"
                    android:textColor="@color/lg_text_primary"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_home_profiles"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/_4sdp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fab_create_profile"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_21sdp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_liquid_chip"
                    android:gravity="center"
                    android:text="＋ NEW"
                    android:textColor="@color/lg_text_primary"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_open_mods_folder"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_21sdp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="@drawable/bg_liquid_chip"
                    android:gravity="center"
                    android:text="MODS DIR"
                    android:textColor="@color/lg_text_primary"
                    android:textSize="@dimen/_7ssp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_refresh_profiles"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_21sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="@drawable/bg_liquid_chip"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="@color/lg_text_primary"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </net.kdt.pojavlaunch.ui.GlassLinearLayout>

        <!-- arsenal shortcuts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_home_mod_shortcut"
                android:layout_width="0dp"
                android:layout_height="@dimen/_23sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_liquid_chip"
                android:gravity="center"
                android:text="⚡ MOD STORE"
                android:textColor="@color/lg_text_primary"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_home_controls_shortcut"
                android:layout_width="0dp"
                android:layout_height="@dimen/_23sdp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_4sdp"
                android:background="@drawable/bg_liquid_chip"
                android:gravity="center"
                android:text="⌨ HUD KEYS"
                android:textColor="@color/lg_text_primary"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         BOTTOM STRIP — TOP MODS, mirrors the L03 mods bar
         ═══════════════════════════════════════════════════════════════════════ -->
    <net.kdt.pojavlaunch.ui.GlassLinearLayout
        android:id="@+id/home_strip"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:lgRadius="17dp"
        app:lgTint="60"
        app:lgScrim="76"
        app:lgRefraction="0.03">

        <TextView style="@style/LiquidLabel" android:text="TOP MODS" android:textSize="@dimen/_6ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:paddingHorizontal="@dimen/_7sdp"
            android:paddingVertical="@dimen/_1sdp"
            android:background="@drawable/bg_liquid_pill"
            android:text="Sodium"
            android:textColor="@color/lg_text_primary"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:paddingHorizontal="@dimen/_7sdp"
            android:paddingVertical="@dimen/_1sdp"
            android:background="@drawable/bg_liquid_pill"
            android:text="Iris"
            android:textColor="@color/lg_text_primary"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:paddingHorizontal="@dimen/_7sdp"
            android:paddingVertical="@dimen/_1sdp"
            android:background="@drawable/bg_liquid_pill"
            android:text="Lithium"
            android:textColor="@color/lg_text_primary"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:paddingHorizontal="@dimen/_7sdp"
            android:paddingVertical="@dimen/_1sdp"
            android:background="@drawable/bg_liquid_pill"
            android:text="Krypton"
            android:textColor="@color/lg_text_primary"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:paddingHorizontal="@dimen/_7sdp"
            android:paddingVertical="@dimen/_1sdp"
            android:background="@drawable/bg_liquid_pill"
            android:text="Ferrite"
            android:textColor="@color/lg_text_primary"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="42 ACTIVE"
            android:textColor="@color/lg_text_primary"
            android:textSize="@dimen/_7ssp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </net.kdt.pojavlaunch.ui.GlassLinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
