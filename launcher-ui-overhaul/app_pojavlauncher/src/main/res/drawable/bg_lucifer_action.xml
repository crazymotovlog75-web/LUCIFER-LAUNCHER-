<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#66120B24" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#442FE9FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFD946EF" android:endColor="#FF2FE9FF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF2FE9FF" android:centerColor="#FF7C3AED" android:endColor="#FFD946EF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#AAFFFFFF" />
        </shape>
    </item>
</selector>
