<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded inner row inside a glass pane (instances, worlds, spec rows). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#8AFFFFFF" android:endColor="#5EFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.2dp" android:color="#E62FE9FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#6BFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#6BFFFFFF" />
        </shape>
    </item>
</selector>
