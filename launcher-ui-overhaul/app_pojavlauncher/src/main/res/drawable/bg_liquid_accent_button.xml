<?xml version="1.0" encoding="utf-8"?>
<!-- Cyan launch pill with the iOS highlight across its top half. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B8FBFF"
                android:centerColor="#6FF3FF"
                android:endColor="#2FE9FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1.6dp">
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
